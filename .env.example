# Supabase Postgres connection string (Settings → Database → Connection string → URI)
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/candleshop"

# Direct connection (used by Prisma migrations only; same as DATABASE_URL for local)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/candleshop"
