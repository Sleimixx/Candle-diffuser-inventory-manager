generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  categories   Category[]
  items        Item[]
  recipes      Recipe[]
  productions  ProductionRun[]
  sales        Sale[]
  adjustments  StockAdjustment[]
}

// ---------- Inventory ----------

model Category {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  unit      String @default("pcs")
  sortOrder Int    @default(0)
  items     Item[]

  @@unique([userId, name])
}

model Item {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  stock       Float        @default(0)
  unitCost    Float        @default(0)
  recipeItems RecipeItem[]
  updatedAt   DateTime     @updatedAt

  @@unique([userId, categoryId, name])
}

// ---------- Recipes ----------

model Recipe {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  salePrice   Float           @default(0)
  notes       String?
  items       RecipeItem[]
  productions ProductionRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, name])
}

model RecipeItem {
  id       String @id @default(cuid())
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId   String
  qty      Float

  @@unique([recipeId, itemId])
}

// ---------- Operations ----------

model ProductionRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  recipeId    String
  quantity    Int
  cogsPerUnit Float
  producedAt  DateTime @default(now())
  sales       Sale[]
}

model Sale {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  production   ProductionRun @relation(fields: [productionId], references: [id], onDelete: Restrict)
  productionId String
  quantity     Int
  unitPrice    Float
  cogsPerUnit  Float
  soldAt       DateTime      @default(now())
}

model StockAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  delta     Float
  reason    String?
  createdAt DateTime @default(now())
}
