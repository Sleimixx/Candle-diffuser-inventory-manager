generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  waxTypes     WaxType[]
  scents       Scent[]
  wicks        Wick[]
  jarSizes     JarSize[]
  jarColors    JarColor[]
  jars         Jar[]
  stickers     Sticker[]
  recipes      CandleRecipe[]
  productions  ProductionRun[]
  sales        Sale[]
  adjustments  StockAdjustment[]
}

// ---------- User-defined product structure ----------

model JarSize {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int            @default(0)
  jars      Jar[]
  stickers  Sticker[]
  recipes   CandleRecipe[]

  @@unique([userId, name])
}

model JarColor {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  hex       String         @default("#888888")
  scentLine String?
  jars      Jar[]
  stickers  Sticker[]
  recipes   CandleRecipe[]

  @@unique([userId, name])
}

// ---------- Raw materials (all user-scoped) ----------

model WaxType {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  stockGrams   Float       @default(0)
  unitCostPerG Float       @default(0)
  isOptional   Boolean     @default(false)
  recipeWaxes  RecipeWax[]
  updatedAt    DateTime    @updatedAt

  @@unique([userId, name])
}

model Scent {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  stockMl       Float         @default(0)
  unitCostPerMl Float         @default(0)
  recipeScents  RecipeScent[]
  updatedAt     DateTime      @updatedAt

  @@unique([userId, name])
}

model Wick {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Jar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sizeId    String
  size      JarSize  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  colorId   String
  color     JarColor @relation(fields: [colorId], references: [id], onDelete: Restrict)
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, sizeId, colorId])
}

model Sticker {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sizeId    String
  size      JarSize  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  colorId   String
  color     JarColor @relation(fields: [colorId], references: [id], onDelete: Restrict)
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, sizeId, colorId])
}

// ---------- Recipes ----------

model CandleRecipe {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sizeId      String
  size        JarSize         @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  colorId     String
  color       JarColor        @relation(fields: [colorId], references: [id], onDelete: Restrict)
  salePrice   Float           @default(0)
  notes       String?
  waxes       RecipeWax[]
  scents      RecipeScent[]
  productions ProductionRun[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, name])
  @@unique([userId, sizeId, colorId])
}

model RecipeWax {
  id       String       @id @default(cuid())
  recipe   CandleRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  wax      WaxType      @relation(fields: [waxId], references: [id], onDelete: Restrict)
  waxId    String
  grams    Float

  @@unique([recipeId, waxId])
}

model RecipeScent {
  id       String       @id @default(cuid())
  recipe   CandleRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
  scent    Scent        @relation(fields: [scentId], references: [id], onDelete: Restrict)
  scentId  String
  ml       Float

  @@unique([recipeId, scentId])
}

// ---------- Operations ----------

model ProductionRun {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe      CandleRecipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  recipeId    String
  quantity    Int
  cogsPerUnit Float
  producedAt  DateTime     @default(now())
  sales       Sale[]
}

model Sale {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  production   ProductionRun @relation(fields: [productionId], references: [id], onDelete: Restrict)
  productionId String
  quantity     Int
  unitPrice    Float
  cogsPerUnit  Float
  soldAt       DateTime      @default(now())
}

model StockAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String
  itemId    String
  delta     Float
  reason    String?
  createdAt DateTime @default(now())
}
