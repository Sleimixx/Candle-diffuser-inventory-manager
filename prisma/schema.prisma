generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Raw materials ----------

model WaxType {
  id            String      @id @default(cuid())
  name          String      @unique
  stockGrams    Float       @default(0)
  unitCostPerG  Float       @default(0)
  isOptional    Boolean     @default(false)
  recipeWaxes   RecipeWax[]
  updatedAt     DateTime    @updatedAt
}

model Scent {
  id            String        @id @default(cuid())
  name          String        @unique
  stockMl       Float         @default(0)
  unitCostPerMl Float         @default(0)
  recipeScents  RecipeScent[]
  updatedAt     DateTime      @updatedAt
}

model Wick {
  id        String   @id @default(cuid())
  type      String   @unique  // "TYPE_1" | "TYPE_2"
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt
}

model WickSticker {
  id        String   @id @default(cuid())
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt
}

model Jar {
  id        String   @id @default(cuid())
  size      String   // "SMALL" | "MEDIUM" | "LARGE"
  color     String   // "PURPLE" | "LIGHT_BLUE" | "RED" | "GREEN" | "YELLOW" | "GREY" | "PINK"
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([size, color])
}

model Sticker {
  id        String   @id @default(cuid())
  size      String
  color     String
  stockQty  Int      @default(0)
  unitCost  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([size, color])
}

// ---------- Recipes ----------

model CandleRecipe {
  id          String        @id @default(cuid())
  name        String        @unique
  jarSize     String        // "SMALL" | "MEDIUM" | "LARGE"
  color       String        // LineColor
  salePrice   Float         @default(0)
  notes       String?
  waxes       RecipeWax[]
  scents      RecipeScent[]
  productions ProductionRun[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([jarSize, color])
}

model RecipeWax {
  id        String       @id @default(cuid())
  recipe    CandleRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
  wax       WaxType      @relation(fields: [waxId], references: [id])
  waxId     String
  grams     Float

  @@unique([recipeId, waxId])
}

model RecipeScent {
  id        String       @id @default(cuid())
  recipe    CandleRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
  scent     Scent        @relation(fields: [scentId], references: [id])
  scentId   String
  ml        Float

  @@unique([recipeId, scentId])
}

// ---------- Operations ----------

model ProductionRun {
  id          String       @id @default(cuid())
  recipe      CandleRecipe @relation(fields: [recipeId], references: [id])
  recipeId    String
  quantity    Int
  cogsPerUnit Float
  producedAt  DateTime     @default(now())
  sales       Sale[]
}

model Sale {
  id           String        @id @default(cuid())
  production   ProductionRun @relation(fields: [productionId], references: [id])
  productionId String
  quantity     Int
  unitPrice    Float
  cogsPerUnit  Float
  soldAt       DateTime      @default(now())
}

model StockAdjustment {
  id        String   @id @default(cuid())
  itemType  String
  itemId    String
  delta     Float
  reason    String?
  createdAt DateTime @default(now())
}
